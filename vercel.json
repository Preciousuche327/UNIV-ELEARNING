{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "feedback.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "feedback_submit.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(css|js|images|assets)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.php"
    }
  ]
}

