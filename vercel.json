{
  "version": 2,
  "functions": {
    "index.php":           { "runtime": "vercel-php@0.7.2" },
    "feedback.php":        { "runtime": "vercel-php@0.7.2" },
    "feedback_submit.php": { "runtime": "vercel-php@0.7.2" },
    "public/index.php":    { "runtime": "vercel-php@0.7.2" }
  },
  "routes": [
    {
      "src": "^/public/(.+)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(css|js|images|assets)/(.*)$",
      "dest": "/public/$1/$2"
    },
    {
      "src": "^/sw\\.js$",
      "dest": "/sw.js"
    },
    {
      "src": "^/manifest\\.json$",
      "dest": "/manifest.json"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.php"
    }
  ]
}

